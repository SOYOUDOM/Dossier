# ── Your workspace ────────────────────────────────────────────────────────
# Dossier owns every path below. Git must never create, replace or delete
# one of them, because people keep records in the same folder they cloned
# this into — and a `git pull` that overwrites dossier.json is the whole of
# somebody's week, gone, with the backups taken out in the same stroke.
#
# The demo workspace that used to sit at dossier.json now lives in demo/,
# where nothing the app writes can collide with it. Copy it in if you want
# something to look at:  copy demo\dossier.json dossier.json
/dossier.json
/dossier.json.bak
/backups/
/tasks/

# what the runner passes back and forth
/scripts/queue/*.run.txt
/scripts/queue/*.done.txt
/scripts/queue/*.out.txt
/scripts/queue/.runner.txt
/scripts/queue/run-*.cmd

# a one-shot launcher Dossier writes beside a record
run-*.cmd

# the art tools are Python; nothing here is a build step
art/__pycache__/

# built on first run by dossier-bridge.bat, from the .cs beside it, and the
# folder it was last told to use
/scripts/bridge/DossierBridge.exe
/scripts/bridge/DossierBridge.pdb
/scripts/bridge/.workspace.txt

# the bridge's handshake - a port and a token, new every run. It belongs to
# the workspace, and shows up here only for anyone whose workspace is this
# folder, which it should not be.
.bridge.json
